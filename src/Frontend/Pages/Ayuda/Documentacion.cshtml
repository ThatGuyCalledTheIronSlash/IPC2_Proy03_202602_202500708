@page
@model Frontend.Pages.Ayuda.DocumentacionModel
@{
    ViewData["Title"] = "Redirigiendo a Documentación PDF...";
}

<div class="container py-5 text-center">
    <div class="spinner-border text-primary mb-3" role="status">
        <span class="visually-hidden">Cargando...</span>
    </div>
    <h3 class="fw-bold">Redirigiendo a la documentación...</h3>
    <p class="text-muted">
        Si no se abre automáticamente en unos segundos, 
        <a href="~/docs/documentacion.pdf" target="_blank" class="fw-bold text-decoration-underline">haz clic aquí para abrir el PDF</a>.
    </p>
</div>

<script>
    window.location.href = '@Url.Content("~/docs/documentacion.pdf")';
</script>
