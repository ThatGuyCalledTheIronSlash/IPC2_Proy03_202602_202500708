@page
@model Frontend.Pages.Ayuda.EstudianteModel
@{
    ViewData["Title"] = "Información del Estudiante - SAT";
}

<div class="container py-4">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="display-5 fw-bold text-dark">Información del Estudiante</h1>
            <p class="lead text-muted">
                Datos académicos del desarrollador del proyecto.
            </p>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card shadow-sm border border-2 border-dark-subtle">
                <div class="card-header bg-dark text-white py-3">
                    <h5 class="card-title mb-0">Datos del Estudiante</h5>
                </div>
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted fw-semibold">Carnet:</span>
                        <span class="fw-bold text-primary">202500708</span>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted fw-semibold">Curso:</span>
                        <span class="fw-semibold">Introducción a la Programación y Computación 2</span>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted fw-semibold">Sección:</span>
                        <span class="badge bg-dark align-self-center">N</span>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted fw-semibold">Semestre:</span>
                        <span>Segundo Semestre 2026</span>
                    </div>
                    <div class="d-flex justify-content-between py-2">
                        <span class="text-muted fw-semibold">Proyecto:</span>
                        <span>Proyecto 3 - Autorizaciones DTE</span>
                    </div>
                </div>
                <div class="card-footer bg-light text-center py-2 text-muted small">
                    Facultad de Ingeniería - USAC
                </div>
            </div>
        </div>
    </div>
</div>
