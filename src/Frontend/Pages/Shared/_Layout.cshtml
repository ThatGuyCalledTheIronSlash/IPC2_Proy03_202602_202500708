<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SAT DTE Simulator</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Frontend.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-area="" asp-page="/Index">
                    <span class="text-primary">SAT</span> DTE
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContenido" aria-controls="navbarContenido"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContenido">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link active" asp-area="" asp-page="/Index">Enviar Mensaje</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="navbarPeticiones" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Peticiones
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="navbarPeticiones">
                                <li><a class="dropdown-item" href="#consultar-contribuyente">Consultar Contribuyente</a></li>
                                <li><a class="dropdown-item" href="#resumen-iva">Resumen de IVA por Fecha y NIT</a></li>
                                <li><a class="dropdown-item" href="#resumen-rango">Resumen por Rango de Fechas</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="navbarAyuda" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Ayuda
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="navbarAyuda">
                                <li><a class="dropdown-item" href="#info-estudiante">Información del Estudiante</a></li>
                                <li><a class="dropdown-item" href="#documentacion">Documentación</a></li>
                            </ul>
                        </li>
                    </ul>
                    <div class="d-flex">
                        <form method="post" action="http://localhost:5000/api/Inicializar" onsubmit="return confirm('¿Estás seguro de que deseas reiniciar todos los datos del sistema?');">
                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                Inicializar Datos
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="pb-5">
        @RenderBody()
    </main>

    <footer class="border-top footer text-muted bg-white py-3 mt-auto">
        <div class="container text-center">
            &copy; 2026 - Sistema de Autorización DTE - IPC2 Proyecto 3
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
