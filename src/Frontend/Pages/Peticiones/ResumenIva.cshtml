@page
@model Frontend.Pages.Peticiones.ResumenIvaModel
@{
    ViewData["Title"] = "Resumen de IVA por Fecha - SAT";
}

<div class="container py-4">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="display-5 fw-bold text-dark">Resumen de IVA por Fecha y NIT</h1>
            <p class="lead text-muted">
                Visualice el desglose del IVA emitido (ventas) e IVA recibido (compras) de cada contribuyente en una fecha específica.
            </p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.MensajeError))
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <h5 class="alert-heading"><i class="bi bi-exclamation-triangle"></i> Error al consultar el resumen</h5>
            <p class="mb-0">@Model.MensajeError</p>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Tarjeta de Selección de Fecha -->
        <div class="col-lg-4 no-print">
            <div class="card shadow-sm border border-2 border-dark-subtle h-100">
                <div class="card-header bg-dark text-white py-3">
                    <h5 class="card-title mb-0">Seleccionar Fecha</h5>
                </div>
                <div class="card-body">
                    <form method="post">
                        <div class="mb-4">
                            <label for="fecha" class="form-label fw-semibold">Fecha a Consultar:</label>
                            <input type="date" class="form-control form-control-lg" id="fecha" name="Fecha" value="@(Model.Fecha?.ToString("yyyy-MM-dd"))" required />
                            <div class="form-text mt-2">
                                Se buscarán todas las facturas autorizadas registradas en esta fecha.
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg shadow-sm">
                                Consultar Resumen
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Tarjeta de Resultados -->
        <div class="col-lg-8">
            <div class="card shadow-sm border border-2 border-dark-subtle h-100">
                <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">Detalle de IVA por Contribuyente</h5>
                    <div class="d-flex align-items-center gap-2">
                        @if (Model.ConsultaRealizada && Model.Resultados != null && Model.Resultados.Length > 0)
                        {
                            <button type="button" class="btn btn-outline-light btn-sm no-print shadow-sm" onclick="window.print()">
                                📄 Generar Reporte PDF
                            </button>
                        }
                        @if (Model.ConsultaRealizada)
                        {
                            <span class="badge bg-success no-print">Fecha: @(Model.Fecha?.ToString("dd/MM/yyyy"))</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary no-print">Sin consulta</span>
                        }
                    </div>
                </div>
                <div class="card-body">
                    @if (Model.ConsultaRealizada && Model.Resultados != null)
                    {
                        <!-- Membrete oficial exclusivo para el reporte PDF -->
                        <div class="print-only mb-4">
                            <div class="text-center border-bottom pb-2 mb-3">
                                <h3 class="fw-bold mb-1">SUPERINTENDENCIA DE ADMINISTRACIÓN TRIBUTARIA</h3>
                                <h5 class="text-muted text-uppercase mb-1">Resumen de IVA por Fecha y NIT</h5>
                                <small class="text-muted">Fecha consultada: @(Model.Fecha?.ToString("dd/MM/yyyy")) | Emitido el: @DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")</small>
                            </div>
                        </div>

                        decimal totalIvaEmitido = 0;
                        decimal totalIvaRecibido = 0;
                        foreach (var item in Model.Resultados)
                        {
                            totalIvaEmitido += item.IvaEmitido;
                            totalIvaRecibido += item.IvaRecibido;
                        }

                        <!-- Métricas superiores -->
                        <div class="row g-3 mb-4">
                            <div class="col-sm-4">
                                <div class="p-3 bg-light rounded border border-secondary-subtle text-center">
                                    <div class="text-muted small fw-semibold text-uppercase">Total IVA Emitido</div>
                                    <div class="fs-4 fw-bold text-primary">Q @totalIvaEmitido.ToString("N2")</div>
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <div class="p-3 bg-light rounded border border-secondary-subtle text-center">
                                    <div class="text-muted small fw-semibold text-uppercase">Total IVA Recibido</div>
                                    <div class="fs-4 fw-bold text-success">Q @totalIvaRecibido.ToString("N2")</div>
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <div class="p-3 bg-light rounded border border-secondary-subtle text-center">
                                    <div class="text-muted small fw-semibold text-uppercase">NITs con Movimiento</div>
                                    <div class="fs-4 fw-bold text-dark">@Model.Resultados.Length</div>
                                </div>
                            </div>
                        </div>

                        @if (Model.Resultados.Length > 0)
                        {
                            <div class="table-responsive">
                                <table class="table table-striped table-hover align-middle border">
                                    <thead class="table-dark">
                                        <tr>
                                            <th scope="col" class="text-center" style="width: 60px;">#</th>
                                            <th scope="col">NIT del Contribuyente</th>
                                            <th scope="col" class="text-end">IVA Emitido (Ventas)</th>
                                            <th scope="col" class="text-end">IVA Recibido (Compras)</th>
                                            <th scope="col" class="text-end">Diferencia</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            int idx = 1;
                                        }
                                        @foreach (var r in Model.Resultados)
                                        {
                                            decimal dif = r.IvaEmitido - r.IvaRecibido;
                                            <tr>
                                                <td class="text-center fw-semibold text-muted">@idx</td>
                                                <td class="fw-bold">@r.Nit</td>
                                                <td class="text-end text-primary fw-semibold">Q @r.IvaEmitido.ToString("N2")</td>
                                                <td class="text-end text-success fw-semibold">Q @r.IvaRecibido.ToString("N2")</td>
                                                <td class="text-end fw-bold @(dif >= 0 ? "text-dark" : "text-danger")">
                                                    Q @dif.ToString("N2")
                                                </td>
                                            </tr>
                                            idx++;
                                        }
                                    </tbody>
                                    <tfoot class="table-light fw-bold">
                                        <tr>
                                            <td colspan="2" class="text-end text-uppercase">Totales del Día:</td>
                                            <td class="text-end text-primary">Q @totalIvaEmitido.ToString("N2")</td>
                                            <td class="text-end text-success">Q @totalIvaRecibido.ToString("N2")</td>
                                            <td class="text-end">Q @((totalIvaEmitido - totalIvaRecibido).ToString("N2"))</td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>

                            <!-- Gráfica Interactiva -->
                            <div class="mt-4 pt-3 border-top no-print">
                                <h6 class="fw-bold text-dark mb-3">Comparativa de IVA Emitido vs. Recibido por NIT</h6>
                                <div style="height: 300px;">
                                    <canvas id="chartIva"></canvas>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5 text-muted">
                                <p class="mb-0 fs-5">No se encontraron facturas autorizadas en la fecha <strong>@(Model.Fecha?.ToString("dd/MM/yyyy"))</strong>.</p>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <p class="mb-0">Seleccione una fecha y presione "Consultar Resumen".</p>
                            <small>Se listará cada NIT con el IVA emitido e IVA recibido correspondiente.</small>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @if (Model.ConsultaRealizada && Model.Resultados != null && Model.Resultados.Length > 0)
    {
        string[] nits = new string[Model.Resultados.Length];
        decimal[] emitidos = new decimal[Model.Resultados.Length];
        decimal[] recibidos = new decimal[Model.Resultados.Length];
        for (int i = 0; i < Model.Resultados.Length; i++)
        {
            nits[i] = Model.Resultados[i].Nit;
            emitidos[i] = Model.Resultados[i].IvaEmitido;
            recibidos[i] = Model.Resultados[i].IvaRecibido;
        }

        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
        <script>
            const nits = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(nits));
            const emitidos = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(emitidos));
            const recibidos = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(recibidos));

            const ctx = document.getElementById('chartIva').getContext('2d');
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: nits,
                    datasets: [
                        {
                            label: 'IVA Emitido (Ventas)',
                            data: emitidos,
                            backgroundColor: '#0d6efd',
                            borderRadius: 4
                        },
                        {
                            label: 'IVA Recibido (Compras)',
                            data: recibidos,
                            backgroundColor: '#198754',
                            borderRadius: 4
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    animation: { duration: 300 },
                    plugins: {
                        legend: { position: 'top' },
                        tooltip: {
                            callbacks: {
                                label: ctx => ` ${ctx.dataset.label}: Q ${ctx.parsed.y.toFixed(2)}`
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: val => 'Q ' + val.toLocaleString()
                            }
                        }
                    }
                }
            });
        </script>
    }
}
